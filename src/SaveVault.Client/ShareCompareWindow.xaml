<Window x:Class="SaveVault.Client.ShareCompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Über Geräte synchronisieren" Height="440" Width="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBgBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Kopf -->
        <StackPanel Grid.Row="0" Margin="0,0,0,6">
            <TextBlock Text="Es gibt bereits einen geteilten Speicherstand" FontSize="18" FontWeight="Bold"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="SubtitleText" Text="" Foreground="{StaticResource MutedBrush}"
                       FontSize="12.5" Margin="0,3,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Zwei Stände nebeneinander -->
        <UniformGrid Grid.Row="1" Columns="2" Margin="0,16,0,0">
            <!-- Lokaler Stand -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="14" Padding="16" Margin="6">
                <StackPanel>
                    <TextBlock Text="Dieser PC (lokal)" FontWeight="SemiBold" FontSize="13.5" />
                    <TextBlock x:Name="LocalDeviceText" Text="" Foreground="{StaticResource MutedBrush}"
                               FontSize="11.5" Margin="0,3,0,14" TextTrimming="CharacterEllipsis" />
                    <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Größe" Foreground="{StaticResource MutedBrush}" FontSize="12.5" />
                        <TextBlock Grid.Column="1" x:Name="LocalSizeText" Text="—" FontWeight="SemiBold" FontSize="12.5" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Dateien" Foreground="{StaticResource MutedBrush}" FontSize="12.5" />
                        <TextBlock Grid.Column="1" x:Name="LocalFilesText" Text="—" FontWeight="SemiBold" FontSize="12.5" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Geteilter Stand -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="14" Padding="16" Margin="6">
                <StackPanel>
                    <TextBlock Text="Geteilter Stand" FontWeight="SemiBold" FontSize="13.5" />
                    <TextBlock x:Name="SharedDeviceText" Text="" Foreground="{StaticResource MutedBrush}"
                               FontSize="11.5" Margin="0,3,0,14" TextTrimming="CharacterEllipsis" />
                    <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Größe" Foreground="{StaticResource MutedBrush}" FontSize="12.5" />
                        <TextBlock Grid.Column="1" x:Name="SharedSizeText" Text="—" FontWeight="SemiBold" FontSize="12.5" />
                    </Grid>
                    <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Dateien" Foreground="{StaticResource MutedBrush}" FontSize="12.5" />
                        <TextBlock Grid.Column="1" x:Name="SharedFilesText" Text="—" FontWeight="SemiBold" FontSize="12.5" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Stand" Foreground="{StaticResource MutedBrush}" FontSize="12.5" />
                        <TextBlock Grid.Column="1" x:Name="SharedTimeText" Text="—" FontWeight="SemiBold" FontSize="12.5" />
                    </Grid>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Aktionen -->
        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Button Content="Abbrechen" Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Left" Click="OnCancelClick" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Meinen lokalen teilen" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,10,0" Click="OnTakeLocalClick"
                        ToolTip="Deinen lokalen Stand als neuen geteilten Stand hochladen." />
                <Button Content="Geteilten übernehmen" Style="{StaticResource PrimaryButton}"
                        Click="OnTakeSharedClick"
                        ToolTip="Den vorhandenen geteilten Stand auf dieses Gerät laden (dein lokaler Stand bleibt als Backup)." />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
