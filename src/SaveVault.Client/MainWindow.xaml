<Window x:Class="SaveVault.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SaveVault.Client"
        mc:Ignorable="d"
        Title="SaveVault" Height="640" Width="470"
        MinWidth="420" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBgBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Grid Margin="20,18,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Kopf -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="SaveVault" FontSize="20" FontWeight="Bold" />
            <TextBlock x:Name="SubtitleText" Text="Spielstände-Synchronisation"
                       Foreground="{StaticResource MutedBrush}" FontSize="12.5" Margin="0,2,0,0" />
        </StackPanel>

        <!-- Verbindungszustand -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="ConnDot" Width="10" Height="10" Fill="{StaticResource OfflineBrush}"
                         VerticalAlignment="Center" Margin="0,0,10,0" />
                <StackPanel>
                    <TextBlock x:Name="ConnText" Text="Nicht eingerichtet" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock x:Name="ConnSubText" Text="" Foreground="{StaticResource MutedBrush}"
                               FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Spiele-Liste / Leerzustand -->
        <Grid Grid.Row="2">
            <ScrollViewer x:Name="GamesScroll" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <ItemsControl x:Name="GamesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Grid.Column="0" Width="10" Height="10"
                                             Fill="{Binding StatusBrush}"
                                             VerticalAlignment="Top" Margin="0,4,12,0" />

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13.5"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusBrush}"
                                                   FontSize="12" FontWeight="SemiBold" Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding FolderText}" Foreground="{StaticResource MutedBrush}"
                                                   FontSize="11.5" Margin="0,4,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding LastActionText}" Foreground="{StaticResource MutedBrush}"
                                                   FontSize="11.5" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <Button Grid.Column="2" Content="Lösen"
                                            Style="{StaticResource BaseButton}"
                                            Background="{StaticResource ConflictBrush}"
                                            Foreground="#221206" BorderThickness="0"
                                            Padding="12,7" VerticalAlignment="Top"
                                            Visibility="{Binding ConflictVisibility}"
                                            Click="OnResolveConflictClick"
                                            Tag="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Leerzustand / nicht eingerichtet -->
            <Border x:Name="EmptyPanel" Style="{StaticResource Card}" VerticalAlignment="Center"
                    Visibility="Collapsed" Padding="22">
                <StackPanel>
                    <TextBlock x:Name="EmptyTitle" Text="Noch nicht eingerichtet"
                               FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyText"
                               Text="Verbinde diesen Client mit deinem SaveVault-Server, um Spielstände zu synchronisieren."
                               Foreground="{StaticResource MutedBrush}" FontSize="12.5"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,16" />
                    <Button x:Name="SetupButton" Content="Einrichten" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Center" Padding="22,9" Click="OnSettingsClick" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Aktionen -->
        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <Button Content="Jetzt synchronisieren" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Stretch" Click="OnSyncNowClick" Margin="0,0,0,8" />
            <UniformGrid Columns="3">
                <Button Content="Spiele neu erkennen" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,4,0" Click="OnRediscoverClick" />
                <Button Content="Ordner hinzufügen" Style="{StaticResource SecondaryButton}"
                        Margin="4,0,4,0" Click="OnAddFolderClick" />
                <Button Content="Einstellungen" Style="{StaticResource SecondaryButton}"
                        Margin="4,0,0,0" Click="OnSettingsClick" />
            </UniformGrid>
        </StackPanel>
    </Grid>
</Window>
