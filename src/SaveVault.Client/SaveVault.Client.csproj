<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SaveVault.Core\SaveVault.Core.csproj" />
  </ItemGroup>

  <!-- ludusavi-Binary (fuer die Spielerkennung) in die Ausgabe/Veroeffentlichung buendeln,
       unter dem von LudusaviClient.DefaultRelativePath erwarteten Pfad tools/ludusavi/.
       Condition: bricht Builds ohne die (gitignorierte) Binary nicht – dann einfach kein Kopieren. -->
  <ItemGroup>
    <None Include="..\..\tools\ludusavi\ludusavi.exe"
          Link="tools\ludusavi\ludusavi.exe"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\..\tools\ludusavi\ludusavi.exe')" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Client-Version (wird als AgentVersion an den Server gemeldet). -->
    <Version>1.0.3</Version>
    <AssemblyVersion>1.0.3</AssemblyVersion>
    <FileVersion>1.0.3</FileVersion>
    <!-- Fuer das eingebaute System.Windows.Forms.NotifyIcon (Tray-Symbol) –
         kein externes NuGet-Paket noetig, Teil der Windows-Desktop-Runtime. -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <!-- WinForms-/Drawing-Namespaces NICHT global importieren: sonst waeren Typen wie
       MessageBox, Application, Color mit ihren WPF-Pendants mehrdeutig. Die wenigen
       WinForms-/Drawing-Typen werden gezielt voll qualifiziert bzw. lokal importiert. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
