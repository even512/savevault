<Window x:Class="SaveVault.Client.ConflictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Konflikt lösen" Height="500" Width="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBgBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Kopf -->
        <StackPanel Grid.Row="0" Margin="0,0,0,6">
            <TextBlock Text="Konflikt lösen" FontSize="18" FontWeight="Bold" />
            <TextBlock x:Name="SubtitleText" Text="" Foreground="{StaticResource MutedBrush}"
                       FontSize="12.5" Margin="0,3,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Teilnehmer-Fassungen -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <ItemsControl x:Name="ParticipantsList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardBrush}"
                                BorderBrush="{Binding BorderBrush}"
                                BorderThickness="{Binding BorderThickness}"
                                CornerRadius="14" Padding="16" Margin="6"
                                Cursor="Hand"
                                MouseLeftButtonUp="OnParticipantClick"
                                Tag="{Binding}">
                            <StackPanel>
                                <TextBlock Text="{Binding DeviceLabel}" FontWeight="SemiBold" FontSize="13.5"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource MutedBrush}"
                                           FontSize="11.5" Margin="0,3,0,14" />

                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Größe" Foreground="{StaticResource MutedBrush}" FontSize="12.5" />
                                    <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontWeight="SemiBold" FontSize="12.5" />
                                </Grid>
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Dateien" Foreground="{StaticResource MutedBrush}" FontSize="12.5" />
                                    <TextBlock Grid.Column="1" Text="{Binding FileCountText}" FontWeight="SemiBold" FontSize="12.5" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Prüfsumme" Foreground="{StaticResource MutedBrush}"
                                               FontSize="12.5" Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding ChecksumText}" FontWeight="SemiBold"
                                               FontSize="12" TextAlignment="Right"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>

                                <TextBlock Text="✓ Ausgewählt" Foreground="{StaticResource SyncingBrush}"
                                           FontWeight="Bold" FontSize="11.5" Margin="0,12,0,0"
                                           Visibility="{Binding SelectedMarkVisibility}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="LoadingText" Text="Lade Konflikt-Details…"
                       Foreground="{StaticResource MutedBrush}" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <TextBlock x:Name="ResultText" Grid.Row="2" Text="" FontSize="12" Margin="0,12,0,0"
                   TextWrapping="Wrap" Visibility="Collapsed" />

        <!-- Aktionen -->
        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Button Content="Beide behalten (umbenennen)" Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Left" Click="OnKeepBothClick" x:Name="KeepBothButton" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Abbrechen" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,10,0" Click="OnCancelClick" />
                <Button x:Name="ResolveButton" Content="Konflikt lösen" Style="{StaticResource PrimaryButton}"
                        IsEnabled="False" Click="OnResolveClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
